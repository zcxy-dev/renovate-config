{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Every zcxy-dev repository's dependency updates: extend github>zcxy-dev/renovate-config",
  "extends": ["config:best-practices", ":semanticCommits", ":semanticCommitScope(deps)"],
  "labels": ["dependencies"],
  "timezone": "Asia/Taipei",
  "schedule": ["* 0-3 * * 1"],
  "minimumReleaseAge": "7 days",
  "prHourlyLimit": 0,
  "major": { "dependencyDashboardApproval": true },
  "vulnerabilityAlerts": { "labels": ["dependencies", "security"] },
  "packageRules": [
    {
      "description": "Seven days for npm too (config:best-practices sets three)",
      "matchDatasources": ["npm"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Lock-file maintenance has no release date to wait for",
      "matchUpdateTypes": ["lockFileMaintenance"],
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "Patch and minor updates merge on their own once the required checks pass, through GitHub's auto-merge",
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"],
      "automerge": true
    },
    { "matchCategories": ["js"], "matchUpdateTypes": ["minor", "patch"], "groupName": "npm non-major" },
    { "matchCategories": ["python"], "matchUpdateTypes": ["minor", "patch"], "groupName": "Python non-major" },
    { "matchManagers": ["mise"], "matchUpdateTypes": ["minor", "patch"], "groupName": "mise tools non-major" },
    { "matchCategories": ["docker"], "matchUpdateTypes": ["minor", "patch", "digest"], "groupName": "Docker images non-major" },
    {
      "description": "Docker images: no wait (a tag's date is its last push)",
      "matchDatasources": ["docker"],
      "minimumReleaseAge": "0 days"
    },
    { "matchManagers": ["github-actions"], "matchUpdateTypes": ["minor", "patch", "digest", "pinDigest"], "groupName": "GitHub Actions non-major" },
    {
      "description": "Node in one pull request wherever it is named, without the wait",
      "matchDepNames": ["node"],
      "minimumReleaseAge": "0 days",
      "groupName": "Node.js"
    },
    {
      "description": "The Python interpreter in one pull request wherever it is named, without the wait; a minor waits for approval",
      "matchDepNames": ["python"],
      "minimumReleaseAge": "0 days",
      "separateMinorPatch": true,
      "minor": { "dependencyDashboardApproval": true },
      "groupName": "Python interpreter"
    },
    {
      "description": "Playwright's packages in one pull request of their own",
      "matchSourceUrls": ["https://github.com/microsoft/playwright"],
      "groupName": "Playwright"
    },
    {
      "description": "Next.js and OpenNext in one pull request",
      "matchSourceUrls": ["https://github.com/vercel/next.js", "https://github.com/opennextjs/**"],
      "groupName": "Next.js"
    },
    {
      "description": "The shared workflows' pins (uses: zcxy-dev/dotfiles/.github/workflows/<name>.yml@<sha> # workflows-vX.Y.Z), every release, a major too, without the wait",
      "matchManagers": ["github-actions"],
      "matchDepNames": ["zcxy-dev/dotfiles"],
      "versioning": "regex:^workflows-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
      "minimumReleaseAge": "0 days",
      "dependencyDashboardApproval": false,
      "schedule": ["at any time"],
      "groupName": "shared workflows"
    }
  ]
}
